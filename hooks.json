{
  "description": "LHC hooks for Codex. Bootstraps ~/.lhc/ runtime on session start and before tool use, re-injects working agreements before compaction, and nudges on Stop when a peer-review gate is still open. All hooks respect DISABLE_LHC=1 and LHC_SKIP_HOOKS=<csv>.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/runtime-touch.js --source session-start --cwd \"$PWD\" >/dev/null",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Bash|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh ./scripts/pretool-runtime-bootstrap.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/precompact-reinject.js",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/stop-reminder.js",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
