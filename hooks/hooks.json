{
  "description": "LHC — bootstrap ~/.lhc runtime on session start, keep it fresh on tool use.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT\"/scripts/runtime-touch.js --source session-start --cwd \"$PWD\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Bash|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT\"/scripts/ensure-runtime.js >/dev/null 2>&1 || true",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
