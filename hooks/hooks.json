{
  "description": "LHC hooks: session/tool bootstrap + PreCompact rule re-injection + Stop reminder for unfinished peer-review gates. All hooks respect DISABLE_LHC=1 and LHC_SKIP_HOOKS=<csv>.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT\"/scripts/runtime-touch.js --source session-start --cwd \"$PWD\" >/dev/null",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Bash|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT\"/scripts/pretool-runtime-bootstrap.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT\"/scripts/precompact-reinject.js",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT\"/scripts/stop-reminder.js",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
